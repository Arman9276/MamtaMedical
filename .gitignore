# ── Secrets (most important — never commit these) ──
.env
.env.*
.dev.vars          # Cloudflare Wrangler local secrets (GROQ_KEY, GEMINI_KEY, etc.)
*.key
*.pem
secrets.json

# ── Cloudflare Worker / Node tooling ──
.wrangler/         # local Wrangler state/cache (created if you run wrangler locally)
node_modules/      # if you ever install wrangler or other npm tools

# ── Scan / build output (generated by the workflows, not source) ──
_site/             # GitHub Pages build folder
*.sarif            # Semgrep / CodeQL / Trivy reports
.trivycache/

# ── Logs ──
*.log
npm-debug.log*

# ── OS & editor junk ──
.DS_Store
Thumbs.db
__MACOSX/
.vscode/
.idea/