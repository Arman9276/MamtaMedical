# Security headers (works on Netlify and Cloudflare Pages)
# These are safe defaults. They harden the site with no functional changes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: SAMEORIGIN

# Admin panel: never allow framing, and keep it out of search engines.
/admin.html
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

# Service worker must always be re-checked so updates reach visitors quickly.
/sw.js
  Cache-Control: no-cache

# ── OPTIONAL: Content-Security-Policy ──
